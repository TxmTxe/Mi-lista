  <script>
    // â”€â”€ Storage helpers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    const STORAGE_KEY = 'nuestra-lista-v1';
    async function loadItems() {
      try {
        const result = await window.storage.get(STORAGE_KEY, true); // shared=true
        return result ? JSON.parse(result.value) : [];
      } catch {
        return [];
      }
    }
    async function saveItems(items) {
      try {
        await window.storage.set(STORAGE_KEY, JSON.stringify(items), true); // shared=true
      } catch (e) {
        console.error(e);
      }
    }
    // â”€â”€ State â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    let items = [];
    let filter = 'all';
    let modalItemId = null;
    let modalQty = 1;
    let pollInterval = null;
    // â”€â”€ Init â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    async function init() {
      items = await loadItems();
      render();
      startPolling();
    }

    function startPolling() {
      // Poll every 5 seconds to sync with partner
      pollInterval = setInterval(async () => {
        const remote = await loadItems();
        const remoteStr = JSON.stringify(remote);
        const localStr = JSON.stringify(items);
        if (remoteStr !== localStr) {
          items = remote;
          render();
          flashSync();
        }
      }, 5000);
    }

    function flashSync() {
      const dot = document.getElementById('syncDot');
      const label = document.getElementById('syncLabel');
      dot.style.background = '#ffd93d';
      dot.style.boxShadow = '0 0 8px #ffd93d';
      label.textContent = 'actualizado';
      setTimeout(() => {
        dot.style.background = '';
        dot.style.boxShadow = '';
        label.textContent = 'sincronizado';
      }, 2000);
    }
    // â”€â”€ Add item â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    async function addItem() {
      const input = document.getElementById('itemInput');
      const cat = document.getElementById('catSelect').value;
      const name = input.value.trim();
      if (!name) return;
      const item = {
        id: Date.now().toString(),
        name,
        emoji: cat,
        qty: 1,
        note: '',
        checked: false,
        createdAt: Date.now()
      };
      items.unshift(item);
      input.value = '';
      render();
      await saveItems(items);
    }
    // â”€â”€ Toggle checked â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    async function toggleItem(id) {
      items = items.map(i => i.id === id ? {
        ...i,
        checked: !i.checked
      } : i);
      render();
      await saveItems(items);
    }
    // â”€â”€ Delete item â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    async function deleteItem(id) {
      const card = document.querySelector(`[data-id="${id}"]`);
      if (card) {
        card.classList.add('removing');
        setTimeout(async () => {
          items = items.filter(i => i.id !== id);
          render();
          await saveItems(items);
        }, 250);
      }
    }
    // â”€â”€ Open modal â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    function openModal(id) {
      const item = items.find(i => i.id === id);
      if (!item) return;
      modalItemId = id;
      modalQty = item.qty;
      document.getElementById('modalItemName').textContent = item.emoji + ' ' + item.name;
      document.getElementById('qtyDisplay').textContent = modalQty;
      document.getElementById('noteInput').value = item.note || '';
      document.getElementById('qtyModal').classList.add('open');
    }

    function closeModal() {
      document.getElementById('qtyModal').classList.remove('open');
      modalItemId = null;
    }
    async function confirmModal() {
      if (!modalItemId) return;
      const note = document.getElementById('noteInput').value.trim();
      items = items.map(i => i.id === modalItemId ? {
        ...i,
        qty: modalQty,
        note
      } : i);
      closeModal();
      render();
      await saveItems(items);
    }
    // â”€â”€ Render â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    function render() {
      const pending = items.filter(i => !i.checked);
      const done = items.filter(i => i.checked);
      document.getElementById('pendingCount').textContent = pending.length;
      document.getElementById('doneCount').textContent = done.length;
      document.getElementById('totalCount').textContent = items.length;
      const clearBtn = document.getElementById('clearDoneBtn');
      clearBtn.className = 'fab ' + (done.length > 0 ? 'visible' : 'hidden');
      let filtered;
      if (filter === 'pending') filtered = pending;
      else if (filter === 'done') filtered = done;
      else filtered = [...pending, ...done];
      const container = document.getElementById('listContainer');
      if (filtered.length === 0) {
        container.innerHTML = `
        <div class="empty">
          <div class="empty-emoji">${filter === 'done' ? 'âœ¨' : 'ğŸ›ï¸'}</div>
          <h3>${filter === 'done' ? 'Â¡Todo pendiente!' : 'La lista estÃ¡ vacÃ­a'}</h3>
          <p>${filter === 'done' ? 'AÃºn no habÃ©is marcado nada.' : 'AÃ±ade el primer producto arriba.'}</p>
        </div>`;
        return;
      }
      let html = '';
      if (filter === 'all' && pending.length > 0) {
        html += `<div class="section-header">Por comprar â€¢ ${pending.length}</div>`;
        pending.forEach(item => {
          html += itemHTML(item);
        });
      }
      if (filter === 'all' && done.length > 0) {
        html += `<div class="section-header">En el carrito â€¢ ${done.length}</div>`;
        done.forEach(item => {
          html += itemHTML(item);
        });
      }
      if (filter !== 'all') {
        filtered.forEach(item => {
          html += itemHTML(item);
        });
      }
      container.innerHTML = html;
      // Attach events
      container.querySelectorAll('.item-card').forEach(card => {
        const id = card.dataset.id;
        card.addEventListener('click', () => toggleItem(id));
      });
      container.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          deleteItem(btn.dataset.id);
        });
      });
      container.querySelectorAll('.item-qty').forEach(badge => {
        badge.addEventListener('click', (e) => {
          e.stopPropagation();
          openModal(badge.dataset.id);
        });
      });
    }

    function itemHTML(item) {
      return `
      <div class="item-card ${item.checked ? 'checked' : ''}" data-id="${item.id}">
        <div class="check-circle">${item.checked ? 'âœ“' : ''}</div>
        <div class="item-emoji">${item.emoji}</div>
        <div class="item-info">
          <div class="item-name">${escapeHTML(item.name)}</div>
          ${item.note ? `<div class="item-meta">ğŸ“ ${escapeHTML(item.note)}</div>` : ''}
        </div>
        <div class="item-qty" data-id="${item.id}">Ã—${item.qty}</div>
        <button class="delete-btn" data-id="${item.id}" title="Eliminar">âœ•</button>
      </div>`;
    }

    function escapeHTML(str) {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
    // â”€â”€ Event listeners â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    document.getElementById('addBtn').addEventListener('click', addItem);
    document.getElementById('itemInput').addEventListener('keydown', e => {
      if (e.key === 'Enter') addItem();
    });
    document.getElementById('filterRow').addEventListener('click', e => {
      const chip = e.target.closest('.filter-chip');
      if (!chip) return;
      document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      filter = chip.dataset.filter;
      render();
    });
    document.getElementById('clearDoneBtn').addEventListener('click', async () => {
      items = items.filter(i => !i.checked);
      render();
      await saveItems(items);
    });
    document.getElementById('qtyMinus').addEventListener('click', () => {
      if (modalQty > 1) modalQty--;
      document.getElementById('qtyDisplay').textContent = modalQty;
    });
    document.getElementById('qtyPlus').addEventListener('click', () => {
      modalQty++;
      document.getElementById('qtyDisplay').textContent = modalQty;
    });
    document.getElementById('confirmQty').addEventListener('click', confirmModal);
    document.getElementById('qtyModal').addEventListener('click', e => {
      if (e.target === document.getElementById('qtyModal')) closeModal();
    });
    // â”€â”€ Start â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    init();
  </script>




  
  
  



