  );
  --cp-button-hover-bg: var(--cp-color-yellow-dark);
  background-size: calc(100% + 6px);
  background-position: -3px 0;
}
.button:not([disabled]).roll-red {
  --cp-button-hover-bg: var(--cp-color-red);
