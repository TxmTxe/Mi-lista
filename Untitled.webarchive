  <title>ğŸ›’ Cositas de casa </title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&amp;family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&amp;display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #0f0f1a;
      --surface: #1a1a2e;
      --surface2: #252540;
      --accent: #ff6b6b;
      --accent2: #ffd93d;
      --accent3: #6bcb77;
      --text: #f0f0f5;
      --muted: #8888aa;
      --border: rgba(255, 255, 255, 0.07);
      --checked-bg: rgba(107, 203, 119, 0.08);
    }

    ``` * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    /* Background texture */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 80% 50% at 20% -10%, rgba(255, 107, 107, 0.12) 0%, transparent 60%),
        radial-gradient(ellipse 60% 40% at 80% 110%, rgba(107, 203, 119, 0.08) 0%, transparent 60%);
      pointer-events: none;
      z-index: 0;
    }

    /* HEADER */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(15, 15, 26, 0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
      padding: 16px 20px 12px;
    }

    .header-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }

    .app-title {
      font-family: 'Syne', sans-serif;
      font-size: 22px;
      font-weight: 800;
      letter-spacing: -0.5px;
    }

    .app-title span {
      color: var(--accent);
    }

    .sync-indicator {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      color: var(--muted);
      font-weight: 500;
    }

    .sync-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent3);
      box-shadow: 0 0 8px var(--accent3);
      animation: pulse 2s infinite;
    }

    @keyframes pulse {

      0%,
      100% {
        opacity: 1;
        transform: scale(1);
      }

      50% {
        opacity: 0.5;
        transform: scale(0.8);
      }
    }

    /* STATS BAR */
    .stats-bar {
      display: flex;
      gap: 10px;
    }

    .stat-pill {
      display: flex;
      align-items: center;
      gap: 5px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 4px 10px;
      font-size: 12px;
      font-weight: 500;
    }

    .stat-pill .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
    }

    .dot-pending {
      background: var(--accent2);
    }

    .dot-done {
      background: var(--accent3);
    }

    /* INPUT AREA */
    .input-area {
      padding: 14px 20px;
      position: relative;
      z-index: 1;
    }

    .input-row {
      display: flex;
      gap: 8px;
      align-items: stretch;
    }

    .cat-select {
      background: var(--surface2);
      border: 1.5px solid var(--border);
      border-radius: 14px;
      color: var(--text);
      font-size: 18px;
      padding: 0 12px;
      cursor: pointer;
      transition: border-color 0.2s;
      min-width: 52px;
      text-align: center;
      appearance: none;
    }

    .cat-select:focus {
      outline: none;
      border-color: var(--accent);
    }

    .text-input {
      flex: 1;
      background: var(--surface2);
      border: 1.5px solid var(--border);
      border-radius: 14px;
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
      font-size: 15px;
      padding: 12px 14px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .text-input::placeholder {
      color: var(--muted);
    }

    .text-input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(255, 107, 107, 0.12);
    }

    .add-btn {
      background: var(--accent);
      border: none;
      border-radius: 14px;
      color: white;
      font-size: 22px;
      width: 52px;
      cursor: pointer;
      transition: transform 0.15s, background 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .add-btn:active {
      transform: scale(0.92);
      background: #e55555;
    }

    /* CATEGORY FILTER */
    .filter-row {
      padding: 0 20px 14px;
      display: flex;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
      position: relative;
      z-index: 1;
    }

    .filter-row::-webkit-scrollbar {
      display: none;
    }

    .filter-chip {
      flex-shrink: 0;
      background: var(--surface2);
      border: 1.5px solid var(--border);
      border-radius: 20px;
      padding: 5px 12px;
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.15s;
      color: var(--muted);
      white-space: nowrap;
    }

    .filter-chip.active {
      background: var(--accent);
      border-color: var(--accent);
      color: white;
    }

    /* LIST */
    main {
      flex: 1;
      padding: 0 16px 100px;
      position: relative;
      z-index: 1;
    }

    .section-header {
      font-family: 'Syne', sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--muted);
      padding: 16px 4px 8px;
    }

    .item-card {
      display: flex;
      align-items: center;
      gap: 12px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 13px 14px;
      margin-bottom: 8px;
      transition: all 0.25s ease;
      position: relative;
      overflow: hidden;
      cursor: pointer;
      animation: slideIn 0.25s ease;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateY(-8px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .item-card.checked {
      background: var(--checked-bg);
      border-color: rgba(107, 203, 119, 0.15);
      opacity: 0.65;
    }

    .item-card.removing {
      animation: slideOut 0.25s ease forwards;
    }

    @keyframes slideOut {
      to {
        opacity: 0;
        transform: translateX(60px);
        height: 0;
        padding: 0;
        margin: 0;
      }
    }

    .check-circle {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      border: 2px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: all 0.2s;
      font-size: 14px;
    }

    .item-card.checked .check-circle {
      background: var(--accent3);
      border-color: var(--accent3);
    }

    .item-emoji {
      font-size: 22px;
      flex-shrink: 0;
      width: 28px;
      text-align: center;
    }

    .item-info {
      flex: 1;
      min-width: 0;
    }

    .item-name {
      font-size: 15px;
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: all 0.2s;
    }

    .item-card.checked .item-name {
      text-decoration: line-through;
      color: var(--muted);
    }

    .item-meta {
      font-size: 11px;
      color: var(--muted);
      margin-top: 2px;
    }

    .item-qty {
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 2px 8px;
      font-size: 12px;
      font-weight: 600;
      color: var(--accent2);
      flex-shrink: 0;
    }

    .delete-btn {
      background: none;
      border: none;
      color: var(--muted);
      font-size: 18px;
      cursor: pointer;
      padding: 4px;
      flex-shrink: 0;
      transition: color 0.15s;
      border-radius: 8px;
    }

    .delete-btn:active {
      color: var(--accent);
    }

    /* QTY INPUT MODAL */
    .qty-modal {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(8px);
      z-index: 200;
      display: flex;
      align-items: flex-end;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s;
    }

    .qty-modal.open {
      opacity: 1;
      pointer-events: all;
    }

    .qty-sheet {
      width: 100%;
      background: var(--surface);
      border-radius: 24px 24px 0 0;
      padding: 20px 24px 40px;
      transform: translateY(100%);
      transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
      border-top: 1px solid var(--border);
    }

    .qty-modal.open .qty-sheet {
      transform: translateY(0);
    }

    .sheet-handle {
      width: 36px;
      height: 4px;
      background: var(--surface2);
      border-radius: 2px;
      margin: 0 auto 20px;
    }

    .sheet-title {
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: 16px;
      margin-bottom: 16px;
      color: var(--muted);
    }

    .sheet-title strong {
      color: var(--text);
      font-size: 20px;
    }

    .qty-controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      margin-bottom: 20px;
    }

    .qty-btn {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      border: 2px solid var(--border);
      background: var(--surface2);
      color: var(--text);
      font-size: 24px;
      cursor: pointer;
      transition: all 0.15s;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .qty-btn:active {
      transform: scale(0.9);
      background: var(--accent);
      border-color: var(--accent);
    }

    .qty-display {
      font-family: 'Syne', sans-serif;
      font-size: 48px;
      font-weight: 800;
      color: var(--accent2);
      min-width: 80px;
      text-align: center;
    }

    .note-input {
      width: 100%;
      background: var(--surface2);
      border: 1.5px solid var(--border);
      border-radius: 14px;
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      padding: 10px 14px;
      margin-bottom: 16px;
      resize: none;
    }

    .note-input:focus {
      outline: none;
      border-color: var(--accent);
    }

    .note-input::placeholder {
      color: var(--muted);
    }

    .confirm-btn {
      width: 100%;
      background: var(--accent);
      border: none;
      border-radius: 14px;
      color: white;
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: 16px;
      padding: 14px;
      cursor: pointer;
      transition: transform 0.15s;
    }

    .confirm-btn:active {
      transform: scale(0.98);
    }

    /* EMPTY STATE */
    .empty {
      text-align: center;
      padding: 60px 20px;
      color: var(--muted);
    }

    .empty-emoji {
      font-size: 56px;
      margin-bottom: 16px;
    }

    .empty h3 {
      font-family: 'Syne', sans-serif;
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 8px;
      color: var(--text);
    }

    .empty p {
      font-size: 14px;
    }

    /* CLEAR DONE FAB */
    .fab {
      position: fixed;
      bottom: 24px;
      right: 20px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 10px 16px;
      font-size: 13px;
      font-weight: 500;
      color: var(--muted);
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      gap: 6px;
      z-index: 50;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    .fab:active {
      transform: scale(0.95);
    }

    .fab.visible {
      opacity: 1;
      pointer-events: all;
    }

    .fab.hidden {
      opacity: 0;
      pointer-events: none;
    }

    ```
