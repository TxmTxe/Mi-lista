    -webkit-transform: rotateZ(0deg);
            transform: rotateZ(0deg);
  }
  25% {
    -webkit-transform: rotateZ(9deg);
            transform: rotateZ(9deg);
  }
  75% {
    -webkit-transform: rotateZ(-9deg);
            transform: rotateZ(-9deg);
  }
  100% {
    -webkit-transform: rotateZ(0deg);
            transform: rotateZ(0deg);
  }
}
@keyframes jiggle {
  0% {
    -webkit-transform: rotateZ(0deg);
            transform: rotateZ(0deg);
  }
  25% {
    -webkit-transform: rotateZ(9deg);
            transform: rotateZ(9deg);
  }
  75% {
    -webkit-transform: rotateZ(-9deg);
            transform: rotateZ(-9deg);
